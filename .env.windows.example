TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_ALLOWED_USER_ID=123456789
TIMEZONE=Asia/Singapore

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_NUM_THREADS=8
OLLAMA_NUM_CTX=2048
# -1 omits Ollama's num_gpu override so Ollama can automatically use the RTX GPU.
OLLAMA_NUM_GPU=-1

DATABASE_PATH=./data/assistant.db
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=./secrets/google_credentials.json
GOOGLE_TOKEN_PATH=./secrets/google_token.json

PENDING_ACTION_TTL_MINUTES=30
REMINDER_POLL_SECONDS=15
CALENDAR_REMINDERS_ENABLED=true
CALENDAR_REMINDER_MINUTES=30
CALENDAR_POLL_SECONDS=300
LOG_LEVEL=INFO
